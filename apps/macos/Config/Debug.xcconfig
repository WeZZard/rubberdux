#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.wezzard.rubberdux.debug
PRODUCT_NAME = Rubberdux (Debug)
RUBBERDUX_WORKSPACE_ROOT = $(SRCROOT)/../..
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
